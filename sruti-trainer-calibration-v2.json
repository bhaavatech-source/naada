{
  "metadata": {
    "title": "Naadopaasana Śruti Trainer & Microtonal Calibration Database",
    "application": "Medhā Nādopāsanā Learning Platform",
    "authoritative_sources": [
      "The Ragas of Karnatic Music by N. S. Ramachandran (University of Madras)",
      "Carnatic Music Book 1 (History and Key Concepts of Carnatic Music)",
      "Melakarta - Wikipedia (Dwadasa & Shodasa Swarasthanas)"
    ],
    "version": "2.0.0",
    "purpose": "Provide exact frequency ratios, vocal kattai reference points, and cognitive score tolerance bands for real-time pitch detection without contradicting the existing web tools.",
    "calibration_reference_statement": "The Śruti Trainer supports two explicit tuning references: (1) Canonical 22-Śruti Just Intonation (default, harmonically pure relative to the Tambura drone overtones), and (2) 12-Tone Equal Temperament (optional, for accompaniment with harmoniums or keyboards). The active mode must be declared to the user. Vocal pitch ranges are suggested starting defaults, not rigid constraints.",
    "active_default_tuning_mode": "CARNATIC_HARMONIC_JUST_INTONATION"
  },
