  "cognitive_tolerance_windows": {
    "Level_1_Beginner_Kids": {
      "description": "Designed for children and young beginners. Accommodates developing vocal cords with a forgiving tolerance band.",
      "tolerance_cents": 40.0,
      "min_hold_duration_sec": 0.5,
      "score_calculation": "Math.max(0, Math.round(100 - (Math.abs(cents_deviation) * 2.5)))",
      "feedback_tiers": {
        "perfect_in_tune": {
          "threshold_cents": 15.0,
          "color": "#10B981",
          "label": "Śruti Śuddham! (Superb!)"
        },
        "acceptable_in_tune": {
          "threshold_cents": 40.0,
          "color": "#F59E0B",
          "label": "Good! Try to hold steady"
        },
        "out_of_tune": {
          "threshold_cents": 999.0,
          "color": "#EF4444",
          "label": "Listen to the tambura and try again"
        }
      }
    },
    "Level_2_Intermediate": {
      "description": "Designed for students who know the basics and are practicing steady swarasthanas and varisais.",
      "tolerance_cents": 20.0,
      "min_hold_duration_sec": 1.0,
      "score_calculation": "Math.max(0, Math.round(100 - (Math.abs(cents_deviation) * 5.0)))",
      "feedback_tiers": {
        "perfect_in_tune": {
          "threshold_cents": 8.0,
          "color": "#10B981",
          "label": "Spot On! True Swarasthanam"
        },
        "acceptable_in_tune": {
          "threshold_cents": 20.0,
          "color": "#F59E0B",
          "label": "Near the note, reduce pitch drift"
        },
        "out_of_tune": {
          "threshold_cents": 999.0,
          "color": "#EF4444",
          "label": "Off Pitch"
        }
      }
    },
    "Level_3_Advanced_Musicians": {
      "description": "Concert-level precision for advanced students and professional musicians.",
      "tolerance_cents": 10.0,
      "min_hold_duration_sec": 1.5,
      "score_calculation": "Math.max(0, Math.round(100 - (Math.abs(cents_deviation) * 10.0)))",
      "feedback_tiers": {
        "perfect_in_tune": {
          "threshold_cents": 4.0,
          "color": "#10B981",
          "label": "Pure Śruti Alignment"
        },
        "acceptable_in_tune": {
          "threshold_cents": 10.0,
          "color": "#F59E0B",
          "label": "Microtonal adjustment needed"
        },
        "out_of_tune": {
