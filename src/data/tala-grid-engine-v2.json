{
  "project": "Medhā Nādopāsanā",
  "module": "Music Builder & Guided Manodharma Creative Suite",
  "sub_module": "Phase 2: Tāla Grid Alignment & Rhythmic Phrase Validator",
  "version": "2.0.0",
  "description": "Complete interactive step-sequencer grid architecture, Gati/Nadai subdivision models, Kāla Krama speed clock, Kārvai/Rest handlers, real-time metric closure validator, Eduppu alignment tracker, and Yati/Makuṭam structural cadence pattern analyzer. Version 2.0 fully populates beat-level kriyas across all 10 Tala templates including Dhruva, Matya, Jhampa, Ata, and Eka Talas.",
  "gati_nadai_definitions": {
    "chaturasra_gati": {
      "id": "chaturasra_gati",
      "name": "Chaturasra Gati (Standard 4-Subdivision)",
      "matras_per_akshara": 4,
      "solkattu": "Ta - ka - dhi - mi",
      "is_default": true,
      "description": "The foundational four-pulse subdivision used across all standard Abhyasa Gana and Sabha Gana compositions."
    },
    "tisra_gati": {
      "id": "tisra_gati",
      "name": "Tisra Gati (Triplet 3-Subdivision)",
      "matras_per_akshara": 3,
      "solkattu": "Ta - ki - ta",
      "is_default": false,
      "description": "Three pulses per beat, creating lilting triplet grooves and characteristic Tisra Nadai variations."
    },
    "khanda_gati": {
      "id": "khanda_gati",
      "name": "Khaṇḍa Gati (Quintuplet 5-Subdivision)",
      "matras_per_akshara": 5,
      "solkattu": "Ta - ka - ta - ki - ta",
      "is_default": false,
      "description": "Five pulses per beat, introducing syncopated asymmetrical rhythmic flow for intermediate/advanced practice."
    },
    "misra_gati": {
      "id": "misra_gati",
      "name": "Miśra Gati (Septuplet 7-Subdivision)",
      "matras_per_akshara": 7,
      "solkattu": "Ta - ki - ta - ta - ka - dhi - mi",
      "is_default": false,
      "description": "Seven pulses per beat, combining three and four sub-pulses for complex laya training."
    },
    "sankeerna_gati": {
      "id": "sankeerna_gati",
      "name": "Saṅkīrṇa Gati (Nonaval 9-Subdivision)",
      "matras_per_akshara": 9,
      "solkattu": "Ta - ka - dhi - mi - ta - ka - ta - ki - ta",
      "is_default": false,
      "description": "Nine pulses per beat (4 + 5), representing the highest traditional subdivision tier in Carnatic rhythmics."
    }
  },
  "kala_krama_speeds": {
    "speed_1x": {
      "speed_multiplier": 1,
      "name": "Prathama Kāla (1st Speed)",
      "swaras_per_akshara": 1,
      "matra_duration_in_chaturasra": 4,
      "ui_badge": "1× Speed",
      "pedagogical_purpose": "Single note per beat. Perfect for young children, foundational pitch grounding, and deep vocal stability."
    },
    "speed_2x": {
      "speed_multiplier": 2,
      "name": "Dvitīya Kāla (2nd Speed)",
      "swaras_per_akshara": 2,
      "matra_duration_in_chaturasra": 2,
      "ui_badge": "2× Speed",
      "pedagogical_purpose": "Two notes per beat (exact 2x tempo). Trains steady metric division and rhythmic fluency."
    },
    "speed_4x": {
      "speed_multiplier": 4,
      "name": "Tṛtīya Kāla (3rd Speed)",
      "swaras_per_akshara": 4,
      "matra_duration_in_chaturasra": 1,
      "ui_badge": "4× Speed",
      "pedagogical_purpose": "Four notes per beat (1 note per matra). Standard concert tempo for fast sangatis, varisais, and kalpanaswarams."
    },
    "speed_8x": {
      "speed_multiplier": 8,
      "name": "Caturtha Kāla (4th Speed)",
      "swaras_per_akshara": 8,
      "matra_duration_in_chaturasra": 0.5,
      "ui_badge": "8× Speed",
      "pedagogical_purpose": "Eight notes per beat (double-fast subdivision). Advanced virtuoso agility training for concert vocalists and instrumentalists."
    }
  },
  "karvai_and_rest_specifications": {
    "karvai": {
      "name": "Kārvai / Dīrgha Hold (Sustained Pitch Extension)",
      "symbols": {
        "web_dash": "—",
        "double_dash": "——",
        "traditional_comma": ",",
        "traditional_semicolon": ";"
      },
      "behavior": "Extends the acoustic sustain of the immediately preceding swara across matras without triggering a new attack or consonant re-articulation.",
      "rules": [
        "A kārvai cannot be placed at the very start of a sequence without a prior sounding swara.",
        "Each single comma (',') or single dash ('—') extends the duration by exactly 1 matra.",
        "A semicolon (';') extends the duration by 2 matras."
      ]
    },
    "rest": {
      "name": "Viśrānti / Rest (Silent Rhythmic Beat Space)",
      "symbols": {
        "underscore": "_",
        "dot": ".",
        "pause_symbol": "rest"
      },
      "behavior": "Mutes sound generation for that specific matra slot while maintaining the ticking tāla pulse and kriyā visualization.",
      "rules": [
        "Rests can be placed at the beginning of an avartana to create Anāgata Eduppu gaps.",
        "Rests can be placed between phrases to create rhythmic breathing spaces."
      ]
    }
  },
