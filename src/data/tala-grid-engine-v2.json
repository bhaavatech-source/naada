  "frontend_reference_code": {
    "validation_algorithm_js": "\nfunction validateRhythmicPhrase(phraseTokens, talaConfig, gatiConfig, targetEduppu) {\n    // phraseTokens: array of objects { type: 'SWARA'|'KARVAI'|'REST', duration_matras: 1|2|4, pitch: 'S'|'R1'... }\n    const totalMatrasInCycle = talaConfig.total_aksharas * gatiConfig.matras_per_akshara;\n    \n    let totalFilledMatras = 0;\n    for (let token of phraseTokens) {\n        totalFilledMatras += token.duration_matras;\n    }\n    \n    const remainder = totalFilledMatras % totalMatrasInCycle;\n    const completedAvartanas = Math.floor(totalFilledMatras / totalMatrasInCycle);\n    \n    let status = '';\n    let message = '';\n    let matrasNeeded = 0;\n    \n    if (totalFilledMatras === 0) {\n        status = 'EMPTY';\n        message = 'Grid is empty. Place swaras or rests to begin.';\n    } else if (remainder === 0) {\n        status = 'EXACT_AVARTANA';\n        message = `Completed ${completedAvartanas} full avartana(s) with perfect metric closure!`;\n    } else {\n        matrasNeeded = totalMatrasInCycle - remainder;\n        const aksharasNeeded = (matrasNeeded / gatiConfig.matras_per_akshara).toFixed(1);\n        status = 'UNDERFILLED';\n        message = `Need ${matrasNeeded} more matra(s) (${aksharasNeeded} aksharas) to complete the avartana.`;\n    }\n    \n    // Check Eduppu landing\n    let eduppuAligned = false;\n    let eduppuOffset = targetEduppu ? targetEduppu.matra_offset : 0;\n    let landingMatra = totalFilledMatras % totalMatrasInCycle;\n    if (landingMatra === eduppuOffset) {\n        eduppuAligned = true;\n    }\n    \n    return {\n        totalFilledMatras,\n        totalMatrasInCycle,\n        completedAvartanas,\n        remainder,\n        matrasNeeded,\n        status,\n        message,\n        eduppuAligned,\n        landingMatra,\n        targetEduppuOffset: eduppuOffset\n    };\n}\n"
  }
}